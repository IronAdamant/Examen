{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.IronAdamant/relatum",
  "title": "Relatum",
  "description": "Pass-by-reference notes for agent swarms, over the same files as the CLI.",
  "version": "1.0.1",
  "repository": {
    "url": "https://github.com/IronAdamant/Relatum",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@iron_adamant/relatum",
      "version": "1.0.1",
      "runtimeHint": "npx",
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Start the stdio MCP server. Same process as relatum-mcp."
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
